rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(courseId) {
      return signedIn() && (
        get(/databases/$(database)/documents/courses/$(courseId)).data.uid == request.auth.uid
        || (exists(/databases/$(database)/documents/courseMembers/$(courseId + "_" + request.auth.uid))
            && get(/databases/$(database)/documents/courseMembers/$(courseId + "_" + request.auth.uid)).data.role == "owner")
      );
    }

    function isMember(courseId) {
      return isOwner(courseId)
        || (signedIn() && exists(/databases/$(database)/documents/courseMembers/$(courseId + "_" + request.auth.uid)));
    }

    // Courses: owners can read/write/delete; members can read
    match /courses/{courseId} {
      allow read: if isMember(courseId);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner(courseId);
    }

    // Course members: owners can read all; members can read; only owners can create (via invitation acceptance batch) and delete
    match /courseMembers/{memberId} {
      allow read: if isMember(resource.data.courseId);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "collaborator"
        && request.resource.data.courseId == resource.data.courseId;
      allow update: if false; // members are immutable after creation
      allow delete: if isOwner(resource.data.courseId);
    }

    // Invitations: owners can list/create/update/delete for their courses; anyone can read a single invitation by token for acceptance
    match /invitations/{invitationId} {
      allow read: if true; // public read for acceptance flow
      allow list: if isOwner(resource.data.courseId);
      allow create: if signedIn()
        && isOwner(request.resource.data.courseId)
        && request.resource.data.status == "pending"
        && request.resource.data.expiresAt > request.time;
      allow update: if signedIn()
        && isOwner(resource.data.courseId)
        && (
          // Resend: pending or expired -> pending, resendCount++, new expiresAt
          (resource.data.status == "pending" || resource.data.status == "expired")
          && request.resource.data.status == "pending"
          && request.resource.data.resendCount == resource.data.resendCount + 1
          && request.resource.data.expiresAt > request.time
        ) || (
          // Accept: pending -> accepted (validated by rules in batch)
          resource.data.status == "pending"
          && request.resource.data.status == "accepted"
          && request.resource.data.acceptedAt != null
          && request.resource.data.acceptedByUid == request.auth.uid
          // The batch create will include courseMember with emailLower matching invitation.emailLower
          // Client must verify email match before sending batch; rules trust the batch atomicity
        ) || (
          // Revoke: pending -> revoked
          resource.data.status == "pending"
          && request.resource.data.status == "revoked"
          && request.resource.data.revokedAt != null
        );
      allow delete: if false; // use status transitions instead
    }

    // Documents and related resources: owners full access; members read + write docs
    match /apaDocuments/{docId} {
      allow read: if isMember(resource.data.courseId);
      allow create: if signedIn()
        && isMember(request.resource.data.courseId)
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && isMember(resource.data.courseId)
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isOwner(resource.data.courseId);
    }

    match /resources/{docId} {
      allow read: if isMember(resource.data.courseId);
      allow create, update: if signedIn() && isOwner(resource.data.courseId);
      allow delete: if isOwner(resource.data.courseId);
    }

    match /tasks/{docId} {
      allow read: if isMember(resource.data.courseId);
      allow create, update: if signedIn() && isOwner(resource.data.courseId);
      allow delete: if isOwner(resource.data.courseId);
    }

    match /scheduleEntries/{docId} {
      allow read: if isMember(resource.data.courseId);
      allow create, update: if signedIn() && isOwner(resource.data.courseId);
      allow delete: if isOwner(resource.data.courseId);
    }

    match /partners/{docId} {
      allow read: if isMember(resource.data.courseId);
      allow create, update, delete: if signedIn() && isOwner(resource.data.courseId);
    }

    // Mail collection for Trigger Email extension: only owners can create
    match /mail/{mailId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Careers: existing rules (owner-only)
    match /careers/{careerId} {
      allow read, write: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}