rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEV ONLY: Open rules are permitted only for local development/emulators.
    // Before deploying to a shared or production Firebase project, replace this
    // catch-all with the secured rules below and deploy with `firebase deploy --only firestore`.
    match /{document=**} {
      allow read, write: if true;
    }

    // PROD: Uncomment the rules below when deploying to production
    // function signedIn() {
    //   return request.auth != null;
    // }

    // Courses: owners full access; members can read
    // match /courses/{courseId} {
    //   allow read: if signedIn() && (resource.data.uid == request.auth.uid || exists(/databases/$(database)/documents/courseMembers/$(courseId + "_" + request.auth.uid)));
    //   allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    //   allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    // }

    // Course members: the member themselves or the course owner can read;
    // only owners can create (via accepted invitation); member or owner can delete (leave / revoke)
    // function isCourseOwner(courseId) {
    //   return get(/databases/$(database)/documents/courses/$(courseId)).data.uid == request.auth.uid;
    // }
    // match /courseMembers/{memberId} {
    //   allow read: if signedIn() && (request.auth.uid == resource.data.uid || isCourseOwner(resource.data.courseId));
    //   allow create: if signedIn()
    //     && request.resource.data.uid == request.auth.uid
    //     && request.resource.data.role == "collaborator";
    //   allow update: if false;
    //   allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isCourseOwner(resource.data.courseId));
    // }

    // Team members: unified roster + invitation/access-status row per course.
    // "local" = name-only roster entry (e.g. for APA covers), no account required.
    // "pending" -> "accepted" (by the invited user) or "revoked" (by the owner).
    // Only the course owner can add/manage rows; anyone can read a row by its token/id.
    // match /teamMembers/{memberId} {
    //   allow read: if true;
    //   allow list: if signedIn() && resource.data.invitedByUid == request.auth.uid;
    //   allow create: if signedIn()
    //     && request.resource.data.invitedByUid == request.auth.uid
    //     && isCourseOwner(request.resource.data.courseId)
    //     && (
    //       request.resource.data.status == "local" || (
    //         request.resource.data.status == "pending"
    //         && request.resource.data.expiresAt > request.time
    //       )
    //     );
    //   allow update: if signedIn()
    //     && (
    //       (
    //         // owner generates an invite link for a local-only roster entry
    //         resource.data.invitedByUid == request.auth.uid
    //         && resource.data.status == "local"
    //         && request.resource.data.status == "pending"
    //         && request.resource.data.expiresAt > request.time
    //       ) || (
    //         // owner renews an expired/unused invite link
    //         resource.data.invitedByUid == request.auth.uid
    //         && resource.data.status == "pending"
    //         && request.resource.data.status == "pending"
    //         && request.resource.data.resendCount == resource.data.resendCount + 1
    //         && request.resource.data.expiresAt > request.time
    //       ) || (
    //         // invited user accepts their own pending invite
    //         resource.data.status == "pending"
    //         && request.resource.data.status == "accepted"
    //         && request.resource.data.acceptedAt != null
    //         && request.resource.data.acceptedByUid == request.auth.uid
    //       ) || (
    //         // owner revokes a pending invite or previously-accepted access
    //         resource.data.invitedByUid == request.auth.uid
    //         && (resource.data.status == "pending" || resource.data.status == "accepted")
    //         && request.resource.data.status == "revoked"
    //         && request.resource.data.revokedAt != null
    //       )
    //     );
    //   allow delete: if signedIn() && isCourseOwner(resource.data.courseId);
    // }

    // Documents and related resources: owner can read/write; course members can read
    // match /apaDocuments/{docId} {
    //   allow read: if signedIn() && (request.auth.uid == resource.data.uid || exists(/databases/$(database)/documents/courseMembers/$(resource.data.courseId + "_" + request.auth.uid)));
    //   allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    //   allow update: if signedIn() && request.resource.data.updatedByUid == request.auth.uid;
    //   allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    // }

    // match /resources/{docId} {
    //   allow read: if signedIn() && (request.auth.uid == resource.data.uid || exists(/databases/$(database)/documents/courseMembers/$(resource.data.courseId + "_" + request.auth.uid)));
    //   allow create, update: if signedIn() && resource.data.uid == request.auth.uid;
    //   allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    // }

    // match /tasks/{docId} {
    //   allow read: if signedIn() && exists(/databases/$(database)/documents/courseMembers/$(resource.data.courseId + "_" + request.auth.uid));
    //   allow create, update: if signedIn() && resource.data.uid == request.auth.uid;
